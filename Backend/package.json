{
  "name": "@atlas/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@hapi/hapi": "^21.4.10",
    "@hapi/joi": "^17.1.1",
    "better-auth": "^1.7.7",
    "cloudinary": "^2.11.0",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "resend": "^6.32.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/hapi__joi": "^17.1.15",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
